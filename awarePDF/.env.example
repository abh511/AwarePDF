# Copy this to .env and fill in your key:  cp .env.example .env
# Free key (no credit card): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- Open-weight models served free by Groq ---
LLM_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.8-27b
# low | medium | high for reasoning models; leave empty for models that don't support it
LLM_REASONING_EFFORT=low
QA_REASONING_EFFORT=medium

# --- Local models (downloaded once from Hugging Face) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=6
CANDIDATES_K=30
USE_RERANKER=True
LLM_MAX_PROMPT_CHARS=16000

# --- PDF parsing (tuned for 700+ page books) ---
PAGE_BATCH_SIZE=40
# Only needed for scanned books; makes parsing several times slower
ENABLE_OCR=False
# fast | accurate
TABLE_MODE=fast

# --- Images ---
ENABLE_IMAGE_EXTRACTION=True
MAX_IMAGES_TO_DESCRIBE=150

# --- App ---
MAX_UPLOAD_SIZE_MB=200
